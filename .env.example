# ── Local development (copy to .env.local) ──────────────────────────────────
# Hosted Supabase: Settings → API (or team vault).
# Google OAuth client ID/secret are configured in the Supabase Dashboard
# (Authentication → Providers → Google), NOT in this file.
#
# Production / Vercel: set the same keys in the Vercel project env UI.
# Full launch steps: see DEPLOY.md

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ≥32 chars. Generate: openssl rand -base64 32
# Use a different value in Vercel Production than local.
RSVP_SESSION_SECRET=dev-session-secret-at-least-32-chars!!

# Public site origin — no trailing slash.
# Local:  http://localhost:3000
# Vercel: https://your-app.vercel.app  (or your custom domain)
# Used for invite links, Stripe returns, calendar, reminder emails.
# OAuth redirect uses window.location.origin; still set this correctly for links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron (/api/cron/reminders + /api/cron/keepalive).
# Generate: openssl rand -base64 32
# Required on Vercel if you want crons (and keep-alive) to succeed.
CRON_SECRET=

# Optional — only needed when exercising those features
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STANDARD_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
RESEND_API_KEY=
RESEND_FROM=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_FAIL_OPEN=
