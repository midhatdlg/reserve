# Hosted Supabase (primary local-dev setup)
# Get these from the team vault or Supabase → Settings → API.
# Google OAuth client ID/secret are configured in the Supabase Dashboard
# (Authentication → Providers → Google), NOT in this file.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RSVP_SESSION_SECRET=dev-session-secret-at-least-32-chars!!
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — only needed when exercising those features
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STANDARD_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
RESEND_API_KEY=
RESEND_FROM=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_FAIL_OPEN=
CRON_SECRET=
